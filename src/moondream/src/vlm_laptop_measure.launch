<launch>
  <!-- Trial / sampling -->
  <arg name="trial_id" default="trial01_lane_02mps"/>
  <arg name="sample_rate" default="1.0"/>
  <arg name="camera_topic" default="/camera/color/image_raw/compressed"/>
  <arg name="vlm_image_topic" default="/vlm/measure/image"/>
  <arg name="done_topic" default="/vlm/measure/done"/>
  <arg name="shutdown_all_on_done" default="true"/>

  <!-- Lane following speed -->
  <arg name="v_base" default="0.20"/>

  <!-- Lane control optional parameters. Defaults match lane_control.py. -->
  <arg name="control_rate" default="30.0"/>
  <arg name="max_steer" default="0.50"/>
  <arg name="lost_timeout" default="1.0"/>

  <!-- Perception debug image. Set false if CPU/network is overloaded. -->
  <arg name="publish_debug" default="false"/>

  <!-- 1. Lane perception -->
  <node pkg="vlm_latency_limo"
        type="camera_lane_perception.py"
        name="camera_lane_perception"
        output="screen">
    <param name="camera_topic" value="$(arg camera_topic)"/>
    <param name="publish_debug" value="$(arg publish_debug)"/>
  </node>

  <!-- 2. Lane control -->
  <node pkg="vlm_latency_limo"
        type="lane_control.py"
        name="lane_control"
        output="screen">
    <param name="v_base" value="$(arg v_base)"/>
    <param name="control_rate" value="$(arg control_rate)"/>
    <param name="max_steer" value="$(arg max_steer)"/>
    <param name="lost_timeout" value="$(arg lost_timeout)"/>
  </node>

  <!-- 3. VLM measurement image sampler -->
  <node pkg="vlm_latency_limo"
        type="vlm_limo_image_sampler.py"
        name="vlm_limo_image_sampler"
        output="screen"
        required="$(arg shutdown_all_on_done)">
    <param name="camera_topic" value="$(arg camera_topic)"/>
    <param name="output_image_topic" value="$(arg vlm_image_topic)"/>
    <param name="sample_rate" value="$(arg sample_rate)"/>
    <param name="trial_id" value="$(arg trial_id)"/>
    <param name="use_now_stamp" value="true"/>
    <param name="done_topic" value="$(arg done_topic)"/>
    <param name="shutdown_on_done" value="true"/>
  </node>
</launch>
